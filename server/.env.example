# PrepPilot AI Backend Environment Variables

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*
STORAGE_DIR=./data/storage
LOG_LEVEL=info

# AI Provider Configuration ('mock' | 'gemini' | 'openai' | 'anthropic')
AI_PROVIDER=mock
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Rate Limits (15-minute window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30

# Remote Code Execution (Judge0 - Optional)
JUDGE0_ENABLED=false
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST_HEADER=judge0-ce.p.rapidapi.com
